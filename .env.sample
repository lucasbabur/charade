# Copy to .env and fill in. .env is gitignored. Every value is optional.

# Overrides for [tool.charade] in pyproject.toml (CHARADE_<FIELD>).
# CHARADE_DATA_DIR=.
# CHARADE_ARTIFACTS_DIR=artifacts/current
# CHARADE_SEED=20141021

# Paid APIs, used only by offline text enrichment (`charade.text`). Never by tests, CI or serving.
# Without them the pipeline uses the committed embedding and attribute cache.
GEMINI_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
